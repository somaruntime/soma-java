{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:somaruntime:soma:runtime-scale-qualification:v2",
  "title": "SOMA Runtime Scale Qualification Record v2",
  "type": "object",
  "additionalProperties": false,
  "x-soma-authoritativeValidator": "io.github.somaruntime.soma.benchmarks.RuntimeScaleQualificationArtifactValidator",
  "x-soma-requiredLanes": [
    "small-fast",
    "medium",
    "1m-single",
    "1m-double",
    "string",
    "expansion",
    "delivery",
    "soak"
  ],
  "x-soma-researchLanes": [
    "10m-research",
    "100m-single-stress",
    "100m-double-stress",
    "100m-string-stress"
  ],
  "x-soma-recordFields": [
    "schemaVersion",
    "artifactVersion",
    "qualificationId",
    "lane",
    "profile",
    "required",
    "applicable",
    "status",
    "claimAllowed",
    "sourceIdentity",
    "environment",
    "preregistration",
    "workload",
    "timing",
    "resource",
    "observation",
    "checksum",
    "limitations",
    "failureReason"
  ],
  "required": [
    "schemaVersion",
    "artifactVersion",
    "qualificationId",
    "lane",
    "profile",
    "required",
    "applicable",
    "status",
    "claimAllowed",
    "sourceIdentity",
    "environment",
    "preregistration",
    "workload",
    "timing",
    "resource",
    "observation",
    "checksum",
    "limitations",
    "failureReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": "soma-runtime-scale-qualification-v2"
    },
    "artifactVersion": {
      "const": "soma-runtime-scale-qualification-runner-v2"
    },
    "qualificationId": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "small-fast",
        "medium",
        "1m-single",
        "1m-double",
        "string",
        "expansion",
        "delivery",
        "soak",
        "10m-research",
        "100m-single-stress",
        "100m-double-stress",
        "100m-string-stress"
      ]
    },
    "profile": {
      "enum": [
        "production-exact-v1",
        "research-stress-v1"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "applicable": {
      "const": true
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "not-applicable"
      ]
    },
    "claimAllowed": {
      "const": false
    },
    "sourceIdentity": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "preregistration": {
      "type": "object"
    },
    "workload": {
      "type": "object",
      "minProperties": 1
    },
    "timing": {
      "type": "object"
    },
    "resource": {
      "type": "object"
    },
    "observation": {
      "type": "object",
      "minProperties": 1
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failureReason": {
      "type": "string"
    }
  }
}
